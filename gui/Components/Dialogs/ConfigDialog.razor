@inject ApiClient Api
@inject AppState State

<div class="dialog-overlay" @onclick="Close">
    <div class="dialog" @onclick:stopPropagation="true">
        <div class="dialog-header">
            <h2>Settings</h2>
            <button class="dialog-close" @onclick="Close">x</button>
        </div>
        <div class="dialog-tabs">
            <button class="dialog-tab @(_activeTab == "model" ? "active" : "")" @onclick='() => _activeTab = "model"'>Model</button>
            <button class="dialog-tab @(_activeTab == "general" ? "active" : "")" @onclick='() => _activeTab = "general"'>General</button>
            <button class="dialog-tab @(_activeTab == "workfolder" ? "active" : "")" @onclick='() => _activeTab = "workfolder"'>Workfolder</button>
            <button class="dialog-tab @(_activeTab == "telegram" ? "active" : "")" @onclick='() => _activeTab = "telegram"'>Telegram</button>
            <button class="dialog-tab @(_activeTab == "about" ? "active" : "")" @onclick='() => _activeTab = "about"'>About</button>
        </div>
        <div class="dialog-body">
            @switch (_activeTab)
            {
                case "model":
                    <div class="form-group">
                        <label>Provider</label>
                        <select value="@_backend" @onchange="OnBackendChanged">
                            <option value="copilot">Copilot SDK</option>
                            <option value="claude">Claude Agent SDK</option>
                            <option value="codex">Codex SDK</option>
                        </select>
                        @if (_backend != _initialBackend)
                        {
                            <div class="hint" style="color: var(--warning, #e8a838);">
                                Switching provider requires a daemon restart.
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <label>Default Model</label>
                        <select @bind="_model">
                            @foreach (var m in _models)
                            {
                                <option value="@m.Id">@m.DisplayLabel</option>
                            }
                        </select>
                    </div>
                    break;

                case "general":
                    <div class="form-group">
                        <label>Display Name</label>
                        <input @bind="_displayName" placeholder="Attache" />
                    </div>
                    <div class="form-group">
                        <div style="margin-top: 4px;">
                            <label style="display: inline-flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                <input type="checkbox" @bind="_selfEdit" style="width: auto;" />
                                Self Edit
                            </label>
                        </div>
                        <div class="hint">Allow the assistant to modify its own source code and configuration.</div>
                    </div>
                    <div class="form-group">
                        <div style="margin-top: 4px;">
                            <label style="display: inline-flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                <input type="checkbox" checked="@State.ShowToolTraces" @onchange="OnToolTracesChanged" style="width: auto;" />
                                Show Tool Traces
                            </label>
                        </div>
                        <div class="hint">Show collapsible tool call details in the conversation transcript.</div>
                    </div>
                    break;

                case "workfolder":
                    <div class="form-group">
                        <label>Working Folder</label>
                        <input @bind="_workfolder" placeholder="C:\path\to\project" />
                        <div class="hint">Changing or clearing the workfolder requires a daemon restart.</div>
                    </div>
                    @if (State.Workfolder?.GitBranch is not null)
                    {
                        <div class="form-group">
                            <label>Git Branch</label>
                            <input value="@State.Workfolder.GitBranch" disabled />
                        </div>
                    }
                    break;

                case "telegram":
                    <div class="form-group">
                        <label>Bot Token</label>
                        <input type="password" @bind="_telegramToken" placeholder="From BotFather" />
                        @if (_telegramTokenConfigured)
                        {
                            <div class="hint" style="margin-top: 6px;">
                                <label style="display: inline-flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                    <input type="checkbox" @bind="_clearTelegramToken" style="width: auto;" />
                                    Clear the saved bot token
                                </label>
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <label>Authorized User ID</label>
                        <input @bind="_telegramUserId" placeholder="Numeric Telegram user ID" />
                        @if (_telegramUserConfigured)
                        {
                            <div class="hint" style="margin-top: 6px;">
                                <label style="display: inline-flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                    <input type="checkbox" @bind="_clearTelegramUserId" style="width: auto;" />
                                    Clear the saved user ID
                                </label>
                            </div>
                        }
                    </div>
                    <div class="hint">Leave a field blank to keep the current saved value. Use the clear toggles to remove saved Telegram settings.</div>
                    break;

                case "about":
                    <div class="form-group">
                        <label>Attache</label>
                        <div class="hint">AI orchestrator with multi-provider backend support</div>
                    </div>
                    @if (State.Diagnostics?.Identity is not null)
                    {
                        <div class="form-group">
                            <label>Name</label>
                            <div>@State.Diagnostics.Identity.ProductName</div>
                        </div>
                    }
                    @if (State.Diagnostics?.Backend is not null)
                    {
                        <div class="form-group">
                            <label>Provider</label>
                            <div>@ProviderDisplayName(State.Diagnostics.Backend.Name)</div>
                        </div>
                    }
                    @if (State.Diagnostics?.Process is not null)
                    {
                        <div class="form-group">
                            <label>Node</label>
                            <div>@State.Diagnostics.Process.NodeVersion</div>
                        </div>
                    }
                    break;
            }
        </div>
        @if (_restartRequired)
        {
            <div class="hint" style="color: var(--warning, #e8a838); padding: 8px 16px; margin: 0 16px;">
                These changes require a daemon restart to take effect.
                <button class="btn btn-primary" style="margin-left: 8px;" @onclick="RestartAndCloseAsync">Restart Now</button>
            </div>
        }
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
            @if (_activeTab != "about")
            {
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Saving..." : "Save")
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string _activeTab = "model";
    private string _model = "";
    private string _backend = "copilot";
    private string _initialBackend = "copilot";
    private string _displayName = "";
    private bool _selfEdit;
    private string _workfolder = "";
    private string _telegramToken = "";
    private string _telegramUserId = "";
    private bool _telegramTokenConfigured;
    private bool _telegramUserConfigured;
    private bool _clearTelegramToken;
    private bool _clearTelegramUserId;
    private bool _saving;
    private bool _restartRequired;
    private List<ModelInfo> _models = [];

    private static readonly List<ModelInfo> FallbackModels =
    [
        new() { Id = "claude-sonnet-4.6", Name = "Claude Sonnet 4.6", Multiplier = 1 },
        new() { Id = "claude-opus-4.6", Name = "Claude Opus 4.6", Multiplier = 1 },
        new() { Id = "gpt-4.1", Name = "GPT-4.1", Multiplier = 0 },
    ];

    protected override async Task OnInitializedAsync()
    {
        var configTask = Api.GetConfigAsync();
        var modelsTask = Api.GetModelsAsync();

        var config = await configTask;
        if (config is not null)
        {
            _model = config.CurrentModel;
            _displayName = config.AssistantDisplayName;
            _backend = config.Backend;
            _initialBackend = config.Backend;
            _selfEdit = config.SelfEdit;
            _telegramTokenConfigured = config.TelegramBotTokenConfigured;
            _telegramUserConfigured = config.AuthorizedUserConfigured;
        }

        _models = await modelsTask;
        if (_models.Count == 0)
            _models = FallbackModels;

        // Ensure current model is in the list
        if (!string.IsNullOrEmpty(_model) && !_models.Any(m => m.Id == _model))
            _models.Insert(0, new ModelInfo { Id = _model, Name = _model });

        if (State.Workfolder is not null)
        {
            _workfolder = State.Workfolder.Path;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        StateHasChanged();

        try
        {
            bool needsRestart = false;
            var desiredModel = _model.Trim();

            switch (_activeTab)
            {
                case "model":
                    _restartRequired = false;
                    // Save provider change first (requires restart)
                    if (_backend != _initialBackend)
                    {
                        var providerSaved = await Api.PostBackendAsync(_backend);
                        if (!providerSaved)
                            return;
                        needsRestart = true;
                    }
                    break;

                case "general":
                    var (_, rr) = await Api.PostConfigAsync(new Dictionary<string, string>
                    {
                        ["ASSISTANT_DISPLAY_NAME"] = _displayName.Trim(),
                        ["ATTACHE_SELF_EDIT"] = _selfEdit ? "1" : "",
                    });
                    _restartRequired = rr;
                    break;

                case "workfolder":
                    var (_, rrWorkfolder) = await Api.PostConfigAsync(new Dictionary<string, string>
                    {
                        ["ATTACHE_WORKFOLDER"] = _workfolder.Trim()
                    });
                    _restartRequired = rrWorkfolder;
                    break;

                case "telegram":
                    var values = new Dictionary<string, string>();
                    if (_clearTelegramToken || !string.IsNullOrWhiteSpace(_telegramToken))
                        values["TELEGRAM_BOT_TOKEN"] = _clearTelegramToken ? "" : _telegramToken.Trim();
                    if (_clearTelegramUserId || !string.IsNullOrWhiteSpace(_telegramUserId))
                        values["AUTHORIZED_USER_ID"] = _clearTelegramUserId ? "" : _telegramUserId.Trim();
                    if (values.Count > 0)
                    {
                        var (_, rrTg) = await Api.PostConfigAsync(values);
                        _restartRequired = rrTg;
                        if (rrTg)
                        {
                            if (_clearTelegramToken)
                                _telegramTokenConfigured = false;
                            else if (!string.IsNullOrWhiteSpace(_telegramToken))
                                _telegramTokenConfigured = true;
                            if (_clearTelegramUserId)
                                _telegramUserConfigured = false;
                            else if (!string.IsNullOrWhiteSpace(_telegramUserId))
                                _telegramUserConfigured = true;
                        }
                    }
                    break;
            }

            if (_activeTab == "model")
            {
                if (needsRestart)
                {
                    await Api.PostRestartAsync();
                    await WaitForBackendAsync(_backend);
                }

                if (!string.IsNullOrWhiteSpace(desiredModel))
                {
                    if (!await RetryPostModelAsync(desiredModel))
                        return;
                }

                _restartRequired = false;
            }
        }
        finally
        {
            _saving = false;
        }

        await RefreshStateAsync();

        if (_restartRequired)
        {
            StateHasChanged();
            return;
        }

        await OnClose.InvokeAsync();
    }

    private async Task RestartAndCloseAsync()
    {
        await Api.PostRestartAsync();
        await OnClose.InvokeAsync();
    }

    private void OnToolTracesChanged(ChangeEventArgs e)
    {
        State.ShowToolTraces = e.Value is true or "true" or "True";
    }

    private async Task OnBackendChanged(ChangeEventArgs e)
    {
        var newBackend = e.Value?.ToString() ?? _backend;
        if (newBackend == _backend) return;
        _backend = newBackend;

        // Fetch models for the newly selected provider
        var models = await Api.GetModelsAsync(_backend);
        if (models.Count == 0)
            models = FallbackModels;
        _models = models;

        // Auto-select first model if current model isn't in the new list
        if (!_models.Any(m => m.Id == _model) && _models.Count > 0)
            _model = _models[0].Id;

        StateHasChanged();
    }

    private static string ProviderDisplayName(string name) => name switch
    {
        "copilot" => "Copilot SDK",
        "claude" => "Claude Agent SDK",
        "codex" => "Codex SDK",
        _ => name,
    };

    private async Task RefreshStateAsync()
    {
        try
        {
            var caps = await Api.GetCapabilitiesAsync();
            if (caps is not null)
                State.Capabilities = caps;

            var diagnostics = await Api.GetDiagnosticsAsync();
            if (diagnostics is not null)
                State.Diagnostics = diagnostics;

            var workfolder = await Api.GetWorkfolderAsync();
            if (workfolder is not null)
                State.Workfolder = workfolder;

            State.NotifyStateChanged();
        }
        catch
        {
            // Best effort: the daemon may be restarting.
        }
    }

    private async Task WaitForBackendAsync(string backend)
    {
        for (var attempt = 0; attempt < 30; attempt++)
        {
            try
            {
                var current = await Api.GetBackendAsync();
                if (current == backend)
                    return;
            }
            catch
            {
                // Daemon may still be coming back.
            }

            await Task.Delay(1000);
        }
    }

    private async Task<bool> RetryPostModelAsync(string model)
    {
        for (var attempt = 0; attempt < 10; attempt++)
        {
            if (await Api.PostModelAsync(model))
                return true;

            await Task.Delay(500);
        }

        return false;
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
