@inject AppState State
@inject ApiClient Api
@inject SseService Sse
@inject IJSRuntime JS
@implements IDisposable

<div class="composer">
    <div class="composer-row">
        <div class="composer-status">
            <StatusDot Status="@ConnectionStatus" />
            <span>@State.StatusMessage</span>
        </div>
    </div>
    <div class="composer-row" style="position: relative; flex-direction: column; align-items: stretch;">
        @if (_showParamMenu && _filteredParams.Count > 0)
        {
            <div class="slash-menu">
                @for (var i = 0; i < _filteredParams.Count; i++)
                {
                    var idx = i;
                    var p = _filteredParams[idx];
                    <div class="slash-item @(idx == _selectedSlashIndex ? "selected" : "")"
                         @onclick="() => ClickParam(idx)">
                        <span class="slash-command">@p.Id</span>
                        <span class="slash-desc">@p.Label</span>
                    </div>
                }
            </div>
        }
        else if (_showSlashMenu && _filteredCommands.Count > 0)
        {
            <div class="slash-menu">
                @for (var i = 0; i < _filteredCommands.Count; i++)
                {
                    var idx = i;
                    var cmd = _filteredCommands[idx];
                    <div class="slash-item @(idx == _selectedSlashIndex ? "selected" : "")"
                         @onclick="() => ClickSlashCommand(idx)">
                        <span class="slash-command">@cmd.Command</span>
                        <span class="slash-desc">@cmd.Description</span>
                        <span class="slash-type">@cmd.Type</span>
                    </div>
                }
            </div>
        }
        @if (_pendingAttachments.Count > 0)
        {
            <div class="attachment-preview">
                @foreach (var att in _pendingAttachments)
                {
                    var a = att;
                    <div class="attachment-chip">
                        @if (a.IsImage && a.ThumbnailDataUri is not null)
                        {
                            <img class="attachment-thumb" src="@a.ThumbnailDataUri" alt="@a.FileName" />
                        }
                        <span class="attachment-name">@a.FileName</span>
                        <button class="attachment-remove" @onclick="() => RemoveAttachment(a)">✕</button>
                    </div>
                }
            </div>
        }
        <div style="display: flex; gap: 8px; align-items: flex-end;">
            <button class="attach-btn" @onclick="PickFilesAsync" title="Attach files" disabled="@(!Sse.IsConnected)">+</button>
            <textarea @oninput="OnInputChanged"
                      @ref="_textareaRef"
                      placeholder="Type a message... (/ for commands)"
                      disabled="@(!Sse.IsConnected)"
                      rows="2"></textarea>
            @if (State.IsProcessing)
            {
                <button class="cancel-btn" @onclick="CancelAsync">Cancel</button>
            }
            else
            {
                <button class="send-btn"
                        @onclick="SendFromButtonAsync"
                        disabled="@(!CanSend)">Send</button>
            }
        </div>
    </div>
</div>

@code {
    private string _input = "";
    private ElementReference _textareaRef;
    private bool _showSlashMenu;
    private bool _showParamMenu;
    private int _selectedSlashIndex;
    private List<SlashCommand> _filteredCommands = [];
    private List<ParamOption> _filteredParams = [];
    private string _activeCommand = "";
    private DotNetObjectReference<ComposerPane>? _dotnetRef;
    private List<ParamOption>? _cachedModelParams;
    private List<AttachmentInfo> _pendingAttachments = [];

    private static readonly string UploadsDir = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
        ".attache", "uploads");

    private static readonly HashSet<string> ImageExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg"
    };

    private record ParamOption(string Id, string Label);

    private string ConnectionStatus => State.ConnectionState switch
    {
        ConnectionState.Connected => "connected",
        ConnectionState.Connecting => "connecting",
        _ => "disconnected"
    };

    private bool CanSend => Sse.IsConnected && (!string.IsNullOrWhiteSpace(_input) || _pendingAttachments.Count > 0) && !State.IsProcessing;

    protected override void OnInitialized()
    {
        State.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        // Invalidate model cache when state changes (e.g. provider switch, reconnect)
        _cachedModelParams = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        _input = e.Value?.ToString() ?? "";
        _ = UpdateSlashPredictionsAsync();
    }

    private async Task UpdateSlashPredictionsAsync()
    {
        var wasMenuOpen = _showSlashMenu || _showParamMenu;

        _showSlashMenu = false;
        _showParamMenu = false;
        _filteredCommands = [];
        _filteredParams = [];

        if (_input.StartsWith("/"))
        {
            // Check if input matches "/<command> <partial-arg>" pattern
            var spaceIdx = _input.IndexOf(' ');
            if (spaceIdx > 0)
            {
                var cmd = _input[..spaceIdx].ToLowerInvariant();
                var argPrefix = _input[(spaceIdx + 1)..].Trim().ToLowerInvariant();
                await TryShowParamMenuAsync(cmd, argPrefix);
            }
            else if (State.Capabilities?.SlashCommands is { Count: > 0 } commands)
            {
                // Still typing the command name
                var prefix = _input.ToLowerInvariant();
                _filteredCommands = commands
                    .Where(c => c.Command.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                    .Take(8)
                    .ToList();
                _showSlashMenu = _filteredCommands.Count > 0;
                _selectedSlashIndex = 0;
            }
        }

        var isMenuOpen = _showSlashMenu || _showParamMenu;
        if (wasMenuOpen != isMenuOpen)
        {
            await JS.InvokeVoidAsync("attache.setSlashMenuOpen", _textareaRef, isMenuOpen);
        }
        StateHasChanged();
    }

    private async Task TryShowParamMenuAsync(string command, string argPrefix)
    {
        List<ParamOption>? options = command switch
        {
            "/model" => await GetModelParamsAsync(),
            "/provider" => [new("copilot", "Copilot SDK"), new("claude", "Claude Agent SDK"), new("codex", "Codex SDK")],
            _ => null
        };

        if (options is null || options.Count == 0) return;

        _activeCommand = command;
        _filteredParams = string.IsNullOrEmpty(argPrefix)
            ? options.Take(12).ToList()
            : options.Where(p => p.Id.Contains(argPrefix, StringComparison.OrdinalIgnoreCase)
                               || p.Label.Contains(argPrefix, StringComparison.OrdinalIgnoreCase))
                     .Take(12).ToList();
        _showParamMenu = _filteredParams.Count > 0;
        _selectedSlashIndex = 0;
    }

    private async Task<List<ParamOption>> GetModelParamsAsync()
    {
        if (_cachedModelParams is not null) return _cachedModelParams;
        var models = await Api.GetModelsAsync();
        _cachedModelParams = models.Select(m => new ParamOption(m.Id, m.Name)).ToList();
        return _cachedModelParams;
    }

    /// <summary>True when a command needs no arguments and can be sent immediately.</summary>
    private static bool IsFireAndForget(SlashCommand cmd)
        => cmd.Type == "builtIn" && cmd.Usage is null;

    /// <summary>Called from JS when a key is pressed while the slash menu is open.</summary>
    [JSInvokable("HandleSlashKey")]
    public async Task HandleSlashKeyAsync(string key)
    {
        if (_showParamMenu)
        {
            var count = _filteredParams.Count;
            if (count == 0) return;
            switch (key)
            {
                case "ArrowDown":
                    _selectedSlashIndex = (_selectedSlashIndex + 1) % count;
                    StateHasChanged();
                    break;
                case "ArrowUp":
                    _selectedSlashIndex = (_selectedSlashIndex - 1 + count) % count;
                    StateHasChanged();
                    break;
                case "Tab":
                    await FillParam(_selectedSlashIndex);
                    break;
                case "Enter":
                    await ActivateParam(_selectedSlashIndex);
                    break;
                case "Escape":
                    _showParamMenu = false;
                    await JS.InvokeVoidAsync("attache.setSlashMenuOpen", _textareaRef, false);
                    StateHasChanged();
                    break;
            }
            return;
        }

        if (_showSlashMenu)
        {
            var count = _filteredCommands.Count;
            if (count == 0) return;
            switch (key)
            {
                case "ArrowDown":
                    _selectedSlashIndex = (_selectedSlashIndex + 1) % count;
                    StateHasChanged();
                    break;
                case "ArrowUp":
                    _selectedSlashIndex = (_selectedSlashIndex - 1 + count) % count;
                    StateHasChanged();
                    break;
                case "Tab":
                    await FillSlashCommand(_selectedSlashIndex);
                    break;
                case "Enter":
                    await ActivateSlashCommand(_selectedSlashIndex);
                    break;
                case "Escape":
                    _showSlashMenu = false;
                    await JS.InvokeVoidAsync("attache.setSlashMenuOpen", _textareaRef, false);
                    StateHasChanged();
                    break;
            }
        }
    }

    /// <summary>Click on a slash command: fire-and-forget commands send, others fill.</summary>
    private async Task ClickSlashCommand(int index)
    {
        await ActivateSlashCommand(index);
    }

    /// <summary>Enter or click: send immediately if no args needed, otherwise fill for editing.</summary>
    private async Task ActivateSlashCommand(int index)
    {
        if (index < 0 || index >= _filteredCommands.Count) return;
        var cmd = _filteredCommands[index];
        if (IsFireAndForget(cmd))
        {
            _showSlashMenu = false;
            _filteredCommands = [];
            await JS.InvokeVoidAsync("attache.setSlashMenuOpen", _textareaRef, false);
            await DoSend(cmd.Command);
        }
        else
        {
            await FillSlashCommand(index);
        }
    }

    private async Task ClickParam(int index) => await ActivateParam(index);

    /// <summary>Fill the input with command + selected parameter value.</summary>
    private async Task FillParam(int index)
    {
        if (index < 0 || index >= _filteredParams.Count) return;
        var p = _filteredParams[index];
        _input = $"{_activeCommand} {p.Id}";
        _showParamMenu = false;
        _filteredParams = [];
        await JS.InvokeVoidAsync("attache.setSlashMenuOpen", _textareaRef, false);
        await JS.InvokeVoidAsync("attache.setComposerValue", _textareaRef, _input);
        StateHasChanged();
    }

    /// <summary>Select parameter and send the command immediately.</summary>
    private async Task ActivateParam(int index)
    {
        if (index < 0 || index >= _filteredParams.Count) return;
        var p = _filteredParams[index];
        var fullCommand = $"{_activeCommand} {p.Id}";
        _showParamMenu = false;
        _filteredParams = [];
        await JS.InvokeVoidAsync("attache.setSlashMenuOpen", _textareaRef, false);
        await DoSend(fullCommand);
    }

    /// <summary>Fill the input with the command + trailing space, then show param popup if applicable.</summary>
    private async Task FillSlashCommand(int index)
    {
        if (index < 0 || index >= _filteredCommands.Count) return;
        var cmd = _filteredCommands[index];
        _input = cmd.Command + " ";
        _showSlashMenu = false;
        _filteredCommands = [];
        await JS.InvokeVoidAsync("attache.setComposerValue", _textareaRef, _input);
        // Trigger param popup for commands that accept parameters
        await UpdateSlashPredictionsAsync();
        StateHasChanged();
    }

    [JSInvokable("JsSend")]
    public async Task JsSendAsync(string text)
    {
        await DoSend(text);
    }

    private async Task SendFromButtonAsync()
    {
        var text = _input.Trim();
        if (string.IsNullOrEmpty(text) && _pendingAttachments.Count == 0) return;
        await DoSend(text);
    }

    private async Task DoSend(string text)
    {
        _input = "";
        _showSlashMenu = false;
        _showParamMenu = false;
        _filteredParams = [];
        var attachments = _pendingAttachments.Count > 0 ? new List<AttachmentInfo>(_pendingAttachments) : null;
        _pendingAttachments.Clear();
        await JS.InvokeVoidAsync("attache.clearComposer", _textareaRef);
        State.AddUserMessage(text, "tui", attachments);

        var connectionId = Sse.ConnectionId;
        if (connectionId is not null)
        {
            var sent = await Api.SendMessageAsync(text, connectionId, attachments);
            if (sent)
            {
                return;
            }
        }

        State.HandleSendFailure("Failed to send message. The daemon may be restarting or the connection expired.");
    }

    private async Task PickFilesAsync()
    {
        try
        {
            var dialog = new OpenFileDialog
            {
                Multiselect = true,
                Title = "Attach files",
                Filter = "All files (*.*)|*.*|Images (*.png;*.jpg;*.jpeg;*.gif;*.webp;*.bmp)|*.png;*.jpg;*.jpeg;*.gif;*.webp;*.bmp",
            };
            if (dialog.ShowDialog() == DialogResult.OK)
            {
                foreach (var path in dialog.FileNames)
                {
                    StageFile(path);
                }
                StateHasChanged();
            }
        }
        catch
        {
            // File dialog may fail in some environments
        }
    }

    private void StageFile(string originalPath)
    {
        try
        {
            Directory.CreateDirectory(UploadsDir);
            var ext = Path.GetExtension(originalPath);
            var stagedName = $"{Guid.NewGuid()}{ext}";
            var stagedPath = Path.Combine(UploadsDir, stagedName);
            File.Copy(originalPath, stagedPath, overwrite: true);
            var isImage = ImageExtensions.Contains(ext);
            string? thumbUri = null;
            if (isImage)
            {
                try
                {
                    var bytes = File.ReadAllBytes(stagedPath);
                    var mime = ext.ToLowerInvariant() switch
                    {
                        ".png" => "image/png",
                        ".gif" => "image/gif",
                        ".webp" => "image/webp",
                        ".bmp" => "image/bmp",
                        ".svg" => "image/svg+xml",
                        _ => "image/jpeg",
                    };
                    thumbUri = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
                }
                catch { /* non-fatal */ }
            }
            _pendingAttachments.Add(new AttachmentInfo
            {
                OriginalPath = originalPath,
                StagedPath = stagedPath,
                FileName = Path.GetFileName(originalPath),
                IsImage = isImage,
                ThumbnailDataUri = thumbUri,
            });
        }
        catch
        {
            // Best effort — skip files that can't be staged
        }
    }

    private void RemoveAttachment(AttachmentInfo att)
    {
        _pendingAttachments.Remove(att);
        try { File.Delete(att.StagedPath); } catch { }
        StateHasChanged();
    }

    [JSInvokable("JsFilesDropped")]
    public void HandleFilesDropped(string[] paths)
    {
        foreach (var path in paths)
        {
            StageFile(path);
        }
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable("JsImagePasted")]
    public void HandleImagePasted(string base64Data, string extension)
    {
        try
        {
            Directory.CreateDirectory(UploadsDir);
            var fileName = $"paste-{DateTime.Now:yyyyMMdd-HHmmss}.{extension}";
            var stagedPath = Path.Combine(UploadsDir, $"{Guid.NewGuid()}.{extension}");
            var bytes = Convert.FromBase64String(base64Data);
            File.WriteAllBytes(stagedPath, bytes);
            var mime = extension switch
            {
                "png" => "image/png",
                "gif" => "image/gif",
                "webp" => "image/webp",
                "bmp" => "image/bmp",
                _ => "image/jpeg",
            };
            _pendingAttachments.Add(new AttachmentInfo
            {
                OriginalPath = stagedPath,
                StagedPath = stagedPath,
                FileName = fileName,
                IsImage = true,
                ThumbnailDataUri = $"data:{mime};base64,{base64Data}",
            });
            InvokeAsync(StateHasChanged);
        }
        catch { /* best-effort */ }
    }

    private async Task CancelAsync()
    {
        await Api.PostCancelAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("attache.initComposer", _textareaRef, _dotnetRef);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        State.OnStateChanged -= HandleStateChanged;
        try { JS.InvokeVoidAsync("attache.disposeComposer", _textareaRef); } catch { }
        _dotnetRef?.Dispose();
    }
}
