@inject AppState State
@inject ApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<div class="pane">
    <div class="pane-header">
        @if (State.ViewingOrchestrator)
        {
            <span>Transcript</span>
        }
        else
        {
            <span>Worker: @(State.SelectedWorker?.Name ?? State.SelectedWorkerId)</span>
        }
    </div>
    <div class="pane-body transcript-body" id="transcript-scroll">
        @if (State.ViewingOrchestrator)
        {
            @* ── Orchestrator transcript ── *@
            @if (State.TranscriptEntries.Count == 0 && State.StreamingContent is null)
            {
                <div class="empty-state">
                    Send a message to start a conversation.
                </div>
            }
            else
            {
                @foreach (var entry in State.TranscriptEntries)
                {
                    <div class="transcript-entry">
                        <div class="entry-header">
                            <span class="@(entry.Role == "user" ? "role-user" : "role-assistant")">
                                @(entry.Role == "user" ? "You" : "Assistant")
                            </span>
                            @if (!string.IsNullOrEmpty(entry.Source) && entry.Source != "tui")
                            {
                                <span class="timestamp">via @entry.Source</span>
                            }
                            <span class="timestamp">@entry.Timestamp.ToString("HH:mm")</span>
                            @if (entry.Route?.Model is not null)
                            {
                                <span class="timestamp">@entry.Route.Model</span>
                            }
                        </div>
                        <div class="entry-content">
                            <MarkdownBlock Content="@entry.Content" />
                        </div>
                    </div>
                }

                @if (State.StreamingContent is not null)
                {
                    <div class="transcript-entry">
                        <div class="entry-header">
                            <span class="role-assistant">Assistant</span>
                            <span class="timestamp">now</span>
                        </div>
                        <div class="entry-content streaming-cursor">
                            <MarkdownBlock Content="@State.StreamingContent" />
                        </div>
                    </div>
                }
            }
        }
        else
        {
            @* ── Worker logs ── *@
            @if (State.WorkerLogs is null)
            {
                <div class="empty-state">Loading worker logs...</div>
            }
            else if (State.WorkerLogs.Length == 0)
            {
                <div class="empty-state">No output yet.</div>
            }
            else
            {
                <div class="worker-logs">
                    <MarkdownBlock Content="@State.WorkerLogs" />
                </div>
            }
        }
    </div>
</div>

@code {
    private int _lastEntryCount;
    private string? _lastStreamingContent;
    private string? _lastWorkerId;
    private System.Timers.Timer? _workerLogTimer;

    protected override void OnInitialized()
    {
        State.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        // If worker selection changed, fetch logs
        if (State.SelectedWorkerId != _lastWorkerId)
        {
            _lastWorkerId = State.SelectedWorkerId;
            StopWorkerLogPolling();
            if (_lastWorkerId is not null)
            {
                _ = FetchWorkerLogsAsync();
                StartWorkerLogPolling();
            }
        }
        InvokeAsync(StateHasChanged);
    }

    private void StartWorkerLogPolling()
    {
        _workerLogTimer = new System.Timers.Timer(2000);
        _workerLogTimer.Elapsed += async (_, _) => await FetchWorkerLogsAsync();
        _workerLogTimer.Start();
    }

    private void StopWorkerLogPolling()
    {
        _workerLogTimer?.Stop();
        _workerLogTimer?.Dispose();
        _workerLogTimer = null;
    }

    private async Task FetchWorkerLogsAsync()
    {
        var workerId = State.SelectedWorkerId;
        if (workerId is null) return;
        var logs = await Api.GetWorkerLogsAsync(workerId);
        if (State.SelectedWorkerId == workerId) // still viewing same worker
        {
            State.WorkerLogs = logs ?? "";
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var entryCount = State.TranscriptEntries.Count;
        var streaming = State.StreamingContent;

        if (entryCount != _lastEntryCount || streaming != _lastStreamingContent)
        {
            _lastEntryCount = entryCount;
            _lastStreamingContent = streaming;

            try
            {
                await JS.InvokeVoidAsync("attache.highlightCode");
                await JS.InvokeVoidAsync("attache.scrollToBottom", "transcript-scroll");
            }
            catch { }
        }
    }

    public void Dispose()
    {
        StopWorkerLogPolling();
        State.OnStateChanged -= HandleStateChanged;
    }
}
