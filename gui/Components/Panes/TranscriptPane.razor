@inject AppState State
@inject ApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<div class="pane">
    @if (State.ViewingOrchestrator)
    {
        <div class="pane-header channel-tabs">
            @foreach (var channel in State.KnownChannels.OrderBy(ChannelOrder))
            {
                var isSelected = channel == State.SelectedChannel;
                var isUnread = State.UnreadChannels.Contains(channel);
                <button class="channel-tab @(isSelected ? "active" : "") @(isUnread ? "unread" : "")"
                        @onclick="() => State.SelectChannel(channel)">
                    @((MarkupString)ChannelLabel(channel))
                    @if (isUnread)
                    {
                        <span class="unread-dot"></span>
                    }
                </button>
            }
        </div>
    }
    else
    {
        <div class="pane-header">
            <span>Worker: @(State.SelectedWorker?.Name ?? State.SelectedWorkerId)</span>
        </div>
    }
    <div class="pane-body transcript-body" id="transcript-scroll">
        @if (State.ViewingOrchestrator && State.SelectedChannel == "cron")
        {
            <CronPane />
        }
        else if (State.ViewingOrchestrator)
        {
            @* ── Orchestrator transcript ── *@
            @if (TranscriptSnapshot.Count == 0 && State.StreamingContent is null)
            {
                <div class="empty-state">
                    Send a message to start a conversation.
                </div>
            }
            else
            {
                @foreach (var entry in TranscriptSnapshot)
                {
                    <div class="transcript-entry @(entry.Role == "user" ? "entry-user" : "entry-assistant")">
                        <div class="entry-header">
                            <span class="@(entry.Role == "user" ? "role-user" : "role-assistant")">
                                @(entry.Role == "user" ? "You" : AssistantName)
                            </span>
                            @if (!string.IsNullOrEmpty(entry.Source) && entry.Source != "tui")
                            {
                                <span class="timestamp">via @entry.Source</span>
                            }
                            <span class="timestamp">@entry.Timestamp.ToString("HH:mm")</span>
                            @if (entry.Route?.Model is not null)
                            {
                                <span class="timestamp">@entry.Route.Model</span>
                            }
                        </div>
                        <div class="entry-content">
                            <MarkdownBlock Content="@entry.Content" />
                        </div>
                        @if (entry.Attachments is { Count: > 0 })
                        {
                            <div class="entry-attachments">
                                @foreach (var att in entry.Attachments)
                                {
                                    <div class="entry-attachment-chip">
                                        @if (att.IsImage && att.ThumbnailDataUri is not null)
                                        {
                                            <img class="attachment-thumb" src="@att.ThumbnailDataUri" alt="@att.FileName" />
                                        }
                                        <span>@att.FileName</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (State.StreamingContent is not null && State.SelectedChannel == "tui")
                {
                    <div class="transcript-entry entry-assistant">
                        <div class="entry-header">
                            <span class="role-assistant">@AssistantName</span>
                            <span class="timestamp">now</span>
                        </div>
                        <div class="entry-content streaming-cursor">
                            <MarkdownBlock Content="@State.StreamingContent" />
                        </div>
                    </div>
                }
            }
        }
        else
        {
            @* ── Worker logs ── *@
            @if (State.SelectedWorker is null)
            {
                <div class="empty-state">Select a worker to view its output.</div>
            }
            else if (State.WorkerLogs is null)
            {
                <div class="empty-state">Loading worker logs...</div>
            }
            else if (State.WorkerLogs.Length == 0)
            {
                <div class="empty-state">@WorkerEmptyStateMessage</div>
            }
            else
            {
                <div class="worker-logs">
                    @if (!string.IsNullOrWhiteSpace(WorkerStatusMessage))
                    {
                        <div class="timestamp" style="margin-bottom: 8px;">@WorkerStatusMessage</div>
                    }
                    <MarkdownBlock Content="@State.WorkerLogs" />
                </div>
            }
        }
    </div>
</div>

@code {
    // Snapshot filtered by selected channel
    private List<TranscriptEntry> TranscriptSnapshot =>
        State.TranscriptEntries
            .Where(e => e.Source == State.SelectedChannel)
            .ToList();

    private string AssistantName =>
        !string.IsNullOrEmpty(State.Capabilities?.Identity?.AssistantDisplayName)
            ? State.Capabilities.Identity.AssistantDisplayName
            : "Assistant";

    // Inline SVG icons for channel tabs (14px, currentColor)
    private const string IconChat = "<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/></svg>";
    private const string IconTelegram = "<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='currentColor'><path d='M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'/></svg>";
    private const string IconCron = "<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>";

    private static readonly Dictionary<string, string> ChannelLabels = new()
    {
        ["tui"] = $"{IconChat} Chat",
        ["telegram"] = $"{IconTelegram} Telegram",
        ["cron"] = $"{IconCron} Cron",
    };

    private static string ChannelLabel(string source) =>
        ChannelLabels.TryGetValue(source, out var label) ? label : source.ToUpperInvariant();

    private static int ChannelOrder(string source) => source switch
    {
        "tui" => 0,
        "telegram" => 1,
        "cron" => 2,
        _ => 3,
    };

    private string WorkerStatusMessage
    {
        get
        {
            var worker = State.SelectedWorker;
            if (worker is null)
                return "";

            if (worker.Status == "running")
            {
                if (worker.ElapsedMs is not null)
                {
                    var elapsed = TimeSpan.FromMilliseconds(worker.ElapsedMs.Value);
                    return $"Running for {FormatDuration(elapsed)}. Waiting for output...";
                }

                if (worker.StartedAt is not null)
                {
                    var started = DateTimeOffset.FromUnixTimeMilliseconds(worker.StartedAt.Value).ToLocalTime();
                    return $"Running since {started:HH:mm}. Waiting for output...";
                }

                return "Running. Waiting for output...";
            }

            if (worker.Status == "error" && !string.IsNullOrWhiteSpace(worker.LastOutput))
            {
                return "Last run ended with an error.";
            }

            return "";
        }
    }

    private string WorkerEmptyStateMessage
    {
        get
        {
            var worker = State.SelectedWorker;
            if (worker is null)
                return "Select a worker to view its output.";

            if (worker.Status == "running")
                return WorkerStatusMessage;

            if (worker.Status == "error")
                return "Last run ended with an error.";

            return "No output yet.";
        }
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        if (duration.TotalMinutes >= 1)
            return $"{(int)duration.TotalMinutes}m {duration.Seconds}s";
        return $"{duration.Seconds}s";
    }

    private int _lastEntryCount;
    private string? _lastStreamingContent;
    private string? _lastWorkerId;
    private System.Timers.Timer? _workerLogTimer;

    protected override void OnInitialized()
    {
        State.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        // If worker selection changed, fetch logs
        if (State.SelectedWorkerId != _lastWorkerId)
        {
            _lastWorkerId = State.SelectedWorkerId;
            StopWorkerLogPolling();
            State.WorkerLogs = null;
            if (_lastWorkerId is not null)
            {
                _ = FetchWorkerLogsAsync();
                StartWorkerLogPolling();
            }
        }
        InvokeAsync(StateHasChanged);
    }

    private void StartWorkerLogPolling()
    {
        _workerLogTimer = new System.Timers.Timer(2000);
        _workerLogTimer.Elapsed += async (_, _) => await FetchWorkerLogsAsync();
        _workerLogTimer.Start();
    }

    private void StopWorkerLogPolling()
    {
        _workerLogTimer?.Stop();
        _workerLogTimer?.Dispose();
        _workerLogTimer = null;
    }

    private async Task FetchWorkerLogsAsync()
    {
        var workerId = State.SelectedWorkerId;
        if (workerId is null) return;
        var logs = await Api.GetWorkerLogsAsync(workerId);
        if (State.SelectedWorkerId == workerId) // still viewing same worker
        {
            State.WorkerLogs = logs ?? "";
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var entryCount = State.TranscriptEntries.Count;
        var streaming = State.StreamingContent;

        if (entryCount != _lastEntryCount || streaming != _lastStreamingContent)
        {
            _lastEntryCount = entryCount;
            _lastStreamingContent = streaming;

            try
            {
                await JS.InvokeVoidAsync("attache.highlightCode");
                await JS.InvokeVoidAsync("attache.scrollToBottom", "transcript-scroll");
            }
            catch { }
        }
    }

    public void Dispose()
    {
        StopWorkerLogPolling();
        State.OnStateChanged -= HandleStateChanged;
    }
}
