@inject AppState State
@implements IDisposable

<div class="pane">
    <div class="pane-header">Inspector</div>
    <div class="pane-body">
        @if (State.Diagnostics is not null)
        {
            @if (State.Workfolder is not null)
            {
                <div class="inspector-section">
                    <h3>Workfolder</h3>
                    <div class="inspector-row">
                        <span class="label">Path</span>
                        <span class="value">@ShortenPath(State.Workfolder.Path)</span>
                    </div>
                    @if (State.Workfolder.GitBranch is not null)
                    {
                        <div class="inspector-row">
                            <span class="label">Git</span>
                            <span class="value" style="color: var(--accent);">@State.Workfolder.GitBranch</span>
                        </div>
                    }
                    else
                    {
                        <div class="inspector-row">
                            <span class="label">Git</span>
                            <span class="value" style="color: var(--text-muted);">not a repo</span>
                        </div>
                    }
                </div>
            }

            <div class="inspector-section">
                <h3>Daemon</h3>
                <div class="inspector-row">
                    <span class="label">Provider</span>
                    <span class="value">@(State.Diagnostics.Backend?.Name ?? "copilot")</span>
                </div>
                <div class="inspector-row">
                    <span class="label">Model</span>
                    <span class="value">
                        @(State.Diagnostics.Model?.Active ?? State.Diagnostics.Model?.Current ?? "—")
                    </span>
                </div>
                <div class="inspector-row">
                    <span class="label">Workers</span>
                    <span class="value">@(State.Diagnostics.Workers?.Running ?? 0) / @(State.Diagnostics.Workers?.Count ?? 0)</span>
                </div>
            </div>

            @if (State.Capabilities is not null)
            {
                <div class="inspector-section">
                    <h3>Capabilities</h3>
                    <div class="inspector-row">
                        <span class="label">Version</span>
                        <span class="value">@State.Capabilities.Version</span>
                    </div>
                    <div class="inspector-row">
                        <span class="label">Skills</span>
                        <span class="value">@(State.Capabilities.SlashCommands.Count(c => c.Type == "skill"))</span>
                    </div>
                    <div class="inspector-row">
                        <span class="label">Tools</span>
                        <span class="value">@State.Capabilities.Tools.Count</span>
                    </div>
                    <div class="inspector-row">
                        <span class="label">Telegram</span>
                        <span class="value" style="color: @(State.Capabilities.Features?.Telegram == true ? "var(--green)" : "var(--text-muted)");">
                            @(State.Capabilities.Features?.Telegram == true ? "enabled" : "disabled")
                        </span>
                    </div>
                    <div class="inspector-row">
                        <span class="label">Self-edit</span>
                        <span class="value" style="color: @(State.Capabilities.Features?.SelfEdit == true ? "var(--green)" : "var(--text-muted)");">
                            @(State.Capabilities.Features?.SelfEdit == true ? "enabled" : "disabled")
                        </span>
                    </div>
                </div>
            }

            <div class="inspector-section">
                <h3>Process</h3>
                <div class="inspector-row">
                    <span class="label">PID</span>
                    <span class="value">@(State.Diagnostics.Process?.Pid)</span>
                </div>
                <div class="inspector-row">
                    <span class="label">Uptime</span>
                    <span class="value">@FormatUptime(State.Diagnostics.Process?.UptimeSeconds ?? 0)</span>
                </div>
                <div class="inspector-row">
                    <span class="label">RSS</span>
                    <span class="value">@FormatBytes(State.Diagnostics.Process?.MemoryUsage?.Rss ?? 0)</span>
                </div>
                <div class="inspector-row">
                    <span class="label">Node</span>
                    <span class="value">@(State.Diagnostics.Process?.NodeVersion ?? "—")</span>
                </div>
                <div class="inspector-row">
                    <span class="label">SSE clients</span>
                    <span class="value">@(State.Diagnostics.Api?.ActiveSseConnections ?? 0)</span>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">Waiting for daemon...</div>
        }

        @if (State.Skills.Count > 0)
        {
            <div class="inspector-section">
                <h3>Skills</h3>
                @foreach (var skill in State.Skills)
                {
                    var stats = State.SkillStats.Find(s => s.Slug == skill.Slug);
                    <div class="skill-item" @onclick="() => ToggleSkill(skill.Slug)">
                        <div class="skill-header">
                            <span class="skill-name">@skill.Name</span>
                            <span class="source-badge source-@skill.Source">@skill.Source</span>
                        </div>
                        @if (_expandedSkill == skill.Slug)
                        {
                            <div class="skill-detail">
                                <div class="skill-description">@skill.Description</div>
                                @if (stats is not null && stats.Total > 0)
                                {
                                    <div class="skill-stats">
                                        <span class="stat">
                                            <span class="stat-value">@stats.Total</span> uses
                                        </span>
                                        <span class="stat">
                                            <span class="stat-value stat-success">@stats.Successes</span>
                                            <span class="stat-sep">/</span>
                                            <span class="stat-value stat-failure">@stats.Failures</span>
                                            <span class="stat-sep">/</span>
                                            <span class="stat-value stat-partial">@stats.Partials</span>
                                        </span>
                                        @if (stats.LastUsed is not null)
                                        {
                                            <span class="stat">@FormatLastUsed(stats.LastUsed)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="skill-stats">
                                        <span class="stat" style="color: var(--text-muted);">never used</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (State.SelectedWorker is not null)
        {
            <div class="inspector-section">
                <h3>Selected Worker</h3>
                <div class="inspector-row">
                    <span class="label">Name</span>
                    <span class="value">@State.SelectedWorker.Name</span>
                </div>
                <div class="inspector-row">
                    <span class="label">Status</span>
                    <span class="value">
                        <StatusDot Status="@State.SelectedWorker.Status" />
                        @State.SelectedWorker.Status
                    </span>
                </div>
                <div class="inspector-row">
                    <span class="label">Directory</span>
                    <span class="value">@State.SelectedWorker.WorkingDir</span>
                </div>
                @if (State.SelectedWorker.ElapsedMs is not null)
                {
                    <div class="inspector-row">
                        <span class="label">Elapsed</span>
                        <span class="value">@FormatElapsed(State.SelectedWorker.ElapsedMs.Value)</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string? _expandedSkill;

    protected override void OnInitialized()
    {
        State.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string ShortenPath(string path)
    {
        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        if (path.StartsWith(home, StringComparison.OrdinalIgnoreCase))
            return "~" + path[home.Length..];
        return path;
    }

    private string FormatUptime(int seconds)
    {
        if (seconds < 60) return $"{seconds}s";
        if (seconds < 3600) return $"{seconds / 60}m {seconds % 60}s";
        return $"{seconds / 3600}h {(seconds % 3600) / 60}m";
    }

    private string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / (1024 * 1024)} MB";
    }

    private void ToggleSkill(string slug)
    {
        _expandedSkill = _expandedSkill == slug ? null : slug;
    }

    private string FormatLastUsed(string isoDate)
    {
        if (!DateTime.TryParse(isoDate, out var dt))
            return isoDate;
        var ago = DateTime.UtcNow - dt.ToUniversalTime();
        if (ago.TotalMinutes < 1) return "just now";
        if (ago.TotalHours < 1) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalDays < 1) return $"{(int)ago.TotalHours}h ago";
        return $"{(int)ago.TotalDays}d ago";
    }

    private string FormatElapsed(long ms)
    {
        var seconds = ms / 1000;
        if (seconds < 60) return $"{seconds}s";
        return $"{seconds / 60}m {seconds % 60}s";
    }

    public void Dispose()
    {
        State.OnStateChanged -= HandleStateChanged;
    }
}
