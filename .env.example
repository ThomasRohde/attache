# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID (send /myid to @userinfobot to get it)
AUTHORIZED_USER_ID=123456789

# Local API port for GUI (default: 7777)
API_PORT=7777

# Default model (default: claude-sonnet-4.6)
COPILOT_MODEL=claude-sonnet-4.6

# Worker timeout in milliseconds (default: 600000 = 10 minutes)
# WORKER_TIMEOUT=600000

# Cosmetic display name (default: Attache)
# ASSISTANT_DISPLAY_NAME=Attache

# Backend provider: copilot (default), claude, or codex
# ATTACHE_BACKEND=copilot

# Default working directory for workers
# ATTACHE_WORKFOLDER=/path/to/your/projects

# Keep PC awake while daemon runs (set to 1 to enable)
# ATTACHE_PREVENT_SLEEP=0

# Allow self-modification (set to 1 to enable — use with caution)
# ATTACHE_SELF_EDIT=0

# API key for Claude backend (required when ATTACHE_BACKEND=claude)
# ANTHROPIC_API_KEY=sk-ant-...

# API key for Codex backend (required when ATTACHE_BACKEND=codex)
# OPENAI_API_KEY=sk-...
